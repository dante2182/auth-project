NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:1234@localhost:5050/project_auth?schema=public"

# Redis (secondary storage de Better Auth: sesiones + códigos con TTL).
# En local apunta al Redis de WSL/Ubuntu (localhost:6379). En tests usa /1.
REDIS_URL="redis://localhost:6379"
BETTER_AUTH_SECRET="7a9f2d4c8b1e5a3f6c9d2b7e4c1f8a3d5e9c2b7f4a1e8d5c3b2f7e4a9c1d5f8" # <-- Esto es un ejemplo
BETTER_AUTH_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:5173"

# Proxies de confianza para resolver la IP real del cliente en el rate limiting
# (Better Auth lee el header x-forwarded-for). CSV de IPs/CIDRs.
# - Local sin proxy: deja los valores de loopback de abajo.
# - Producción: pon los rangos de tu host (Vercel, Railway, Render, nginx,
#   Cloudflare...) — ver documentación del host; solo cambias esta variable,
#   no el código.
TRUSTED_PROXIES="::1,::ffff:127.0.0.1,127.0.0.1"

# --- OAuth (GitHub y Google) ---
# Crea una OAuth App en GitHub (Settings > Developer settings > OAuth Apps):
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# Crea un OAuth Client en Google Cloud Console (Credentials > OAuth 2.0 Client IDs):
#   Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_EMAIL="admin@admin.com"
ADMIN_PASSWORD="admin12345"
